# Template for your own .env file. Copy it to .env and fill in real values.
# .env is git-ignored; never commit real keys.

# Your Google Cloud project ID (the same project as the payment assurance monitor)
GCP_PROJECT_ID=your-gcp-project-id

# Full path to the BUILDER service-account key file. Keep it outside this folder.
# This account loads the raw data and runs dbt. The agent gets its own
# read-only account later.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\asa-builder-key.json
